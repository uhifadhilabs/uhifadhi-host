# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> uhifadhi/telemetry ###
# The API request/response monitor (src/Telemetry) writes to its OWN database on a
# second Doctrine connection ("telemetry"), sharing nothing with DATABASE_URL.
#
# Dev/test default below: an embedded SQLite file — no separate server to provision.
#
# PRODUCTION: no separate secret needed. The deploy workflow DERIVES this from the
# DATABASE_URL secret — same host, user and password, dbname `uhifadhi_telemetry` — and
# the post-deploy hook creates it (doctrine:database:create --connection=telemetry) and
# migrates it (telemetry:migrate) automatically. Set a TELEMETRY_DATABASE_URL secret only
# to override. Derived shape:
#   postgresql://uhifadhi:PASSWORD@HOST:5432/uhifadhi_telemetry?serverVersion=17&charset=utf8
TELEMETRY_DATABASE_URL="sqlite:///%kernel.project_dir%/var/telemetry_%kernel.environment%.db"
###< uhifadhi/telemetry ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> uhifadhi/fixtures-module ###
# Demo-account passwords (the fixtures seed refuses these placeholders - set real
# values in .env.local). The Super Admin (impersonation) gets its own.
DEMO_PASSWORD=changeme-in-env-local
DEMO_SUPER_ADMIN_PASSWORD=changeme-in-env-local
# Domain of the generated demo-account emails (override in .env.local to keep
# deployment-specific logins working, e.g. your prod domain).
SEEDER_EMAIL_DOMAIN=uhifadhi.test
###< uhifadhi/fixtures-module ###

###> uhifadhi/storage-module ###
# WHERE FIELD PHOTOGRAPHS LIVE IN PRODUCTION — Hetzner Object Storage.
#
# Unset here on purpose: config/packages/storage.yaml selects the LOCAL adapter,
# which needs none of these, and a half-filled S3 block is how a deployment ends
# up failing on its first upload rather than at compile time. To move the bytes
# to object storage, set these in the prod secret store and switch
# storage.evidence.adapter to "s3" (see the commented block in that file).
#
# STORAGE_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# STORAGE_S3_BUCKET=uhifadhi-evidence
# STORAGE_S3_REGION=fsn1
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=
###< uhifadhi/storage-module ###

###> uhifadhi/map-module ###
# Satellite imagery key, used only when a deployment sets the satellite
# provider to google (see config/packages/map.yaml). Unset is a valid state:
# the bundle draws keyless Esri World Imagery and asks nobody. Public by
# nature - it travels inside every tile URL - so restrict it by HTTP referrer
# at Google rather than treating it as a secret. A missing key must never
# break a map, and it does not.
# https://developers.google.com/maps/documentation/tile/session_tokens
UHIFADHI_GOOGLE_MAPS_API_KEY=
###< uhifadhi/map-module ###
