{# The org-wide TEAM dashboard (settled design: uhifadhi-web/team/index.html; the Positions half
   drawn five ways in uhifadhi-ops/designs/ngoro-positions-{a..e}.html, all five shipped as
   widgets). Everything below the header is the platform widget framework: the person's own
   resolved layout, in their own order, with the widgets they switched off simply absent.

   Every widget is a partial in this folder and receives exactly the surface's context — see
   Uhifadhi\Service\TeamService::context(). #}
{% extends 'layout.html.twig' %}

{% block title %}Team — Uhifadhi{% endblock %}

{% block content %}
    <div class="page">
        <div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / team</div>

        <div class="pghead">
            <div>
                <h1 class="pg">Team</h1>
                <p class="pgsub">People, the positions that grant them permissions, and the departments those
                    positions belong to. A <b>Staff</b> member holds exactly their position’s permissions; managers and
                    admins hold everything by tier. A position is written department-first —
                    <span class="mono tm-eg">Ecology / Analyst</span> — because its name is unique only
                    <b>inside</b> its department.</p>
            </div>
            <div class="pgact w-pgact">
                <a class="tgl w-act" href="{{ path('app_team_position_new') }}">{{ ux_icon('lucide:plus') }}New position</a>
                <a class="tgl w-act" href="{{ path('app_team_widgets') }}">{{ ux_icon('lucide:layout-grid') }}Widget library</a>
            </div>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="c tm-flash"><span class="acc">{{ label == 'error' ? '!' : '✓' }}</span> {{ message }}</div>
            {% endfor %}
        {% endfor %}

        {# EXACTLY what a partial receives, stated once. with_context: false so the contract is
           the contract: a partial that reaches for a variable this map does not name fails here,
           on the surface that owns it, rather than on whichever screen borrows it next. #}
        {% set widgetContext = {
            members: members,
            positions: positions,
            departments: departments,
            bands: bands,
            holders: holders,
            twins: twins,
            scope: scope,
            rail: rail,
            canManage: canManage,
            manageToken: manageToken,
            catalogue: catalogue,
        } %}

        <div class="w-grid">
            {# A switched-off widget is simply absent — not hidden, not an empty cell. #}
            {% for widget in widgets|filter(w => w.on) %}
                {# w-span-N, never w-N: a bare `w-12` is Tailwind's width utility and would
                   render this cell 48px wide (see the widget-framework block in app.css). #}
                <div class="w-cell w-span-{{ widget.cols }}" data-widget-id="{{ widget.id }}" data-widget-cols="{{ widget.cols }}">
                    <div class="w-inner">
                        {{ include('team/_w_' ~ widget.id ~ '.html.twig', widgetContext, with_context: false) }}
                    </div>
                </div>
            {% endfor %}
            {# The door to editing, in the grid itself — adding/removing/arranging happens in the
               LIBRARY; this tile makes that reachable from where you notice a widget is missing. #}
            <a class="w-cell w-span-12 w-addtile" href="{{ path('app_team_widgets') }}">
                {{ ux_icon('lucide:plus') }}<span>Add widgets — open the library</span>
            </a>
        </div>
    </div>
{% endblock %}
