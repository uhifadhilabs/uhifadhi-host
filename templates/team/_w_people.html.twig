{# TEAM widget 'people' — the roster, and the one control that changes what a person may do:
   their position. Design: uhifadhi-web/team/team.widgets.js → people.

   A person's TIER is set on their own account; managing tiers hold everything by tier and
   therefore hold no position at all. A person's DEPARTMENT is read-only here — it follows their
   position, so moving a position moves every holder with it.

   Every position is written DEPARTMENT-FIRST, in the cell and in the dropdown, because a bare
   "Analyst" names two different positions with two different permission sets.

   Receives: members, positions, departments, bands, holders, twins, scope, rail, canManage,
   manageToken, catalogue. #}
{% import 'team/_positions.html.twig' as pos %}

<div class="c" data-people>
    <span class="tab">People<span class="src">· {{ members|length }} member{{ members|length == 1 ? '' : 's' }}</span></span>

    {# The scroll lives on this wrapper, never on the plate: a plate that scrolls itself clips the
       tab hanging over its own top border, and the title is cut in half. #}
    <div class="tm-tblwrap">
    <table class="tbl">
        <thead>
        <tr>
            <th>Member</th><th>Email</th><th>Tier</th><th>Position</th>
            <th class="dept-col">Department</th>
            {% if canManage %}<th>Assign</th>{% endif %}
            {# Handing somebody a way in is a Super Admin act, exactly as minting them is. #}
            {% if is_granted('ROLE_SUPER_ADMIN') %}<th>Password</th>{% endif %}
        </tr>
        </thead>
        <tbody>
        {% for member in members %}
            <tr>
                <td>
                    <div class="who">
                        <span class="avatar sm">{{ (member.firstName|default('')|first ~ member.lastName|default('')|first)|upper }}</span>
                        <b>{{ member.fullName }}</b>
                    </div>
                </td>
                <td class="fog mono email">{{ member.email }}</td>
                <td><span class="tier t-{{ member.teamRole.value }}">{{ member.teamRole.label }}</span></td>

                <td>
                    {% if member.teamRole.canManageContent %}
                        <span class="fog mono tm-none">— by tier</span>
                    {% elseif member.position %}
                        {{ pos.qualified(member.position) }}{{ pos.twin(member.position, twins) }}
                    {% else %}
                        <span class="fog mono tm-none">unassigned</span>
                    {% endif %}
                </td>

                {# Read-only: a person's department is their position's department, always. #}
                <td class="dept-col">
                    {% if member.teamRole.canManageContent %}
                        <span class="fog mono tm-none">— all departments</span>
                    {% elseif member.position and member.position.department %}
                        <b>{{ member.position.department.name }}</b><span class="dept-via">via position</span>
                    {% else %}
                        <span class="fog mono tm-none">—</span>
                    {% endif %}
                </td>

                {% if canManage %}
                    <td>
                        {% if member.teamRole.canManageContent %}
                            <span class="fog mono tm-none">—</span>
                        {% else %}
                            <form method="post" action="{{ path('app_team_member_assign', {uuid: member.uuidString}) }}" class="assign">
                                <input type="hidden" name="_token" value="{{ csrf_token('team_member_assign_' ~ member.uuidString) }}">
                                {# Department-first here too: two departments' "Analyst" can never
                                   be picked for each other from a dropdown that writes both the
                                   same way. The list is in band order, so a department's
                                   positions arrive together. #}
                                <select name="position" class="fld sel" aria-label="Position of {{ member.fullName }}">
                                    <option value="">— unassigned —</option>
                                    {% for position in positions %}
                                        <option value="{{ position.uuidString }}" {{ member.position and member.position.uuidString == position.uuidString ? 'selected' }}>
                                            {{ position.department ? position.department.name : 'Unfiled' }} / {{ position.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                                <button class="open-btn" type="submit">Set</button>
                            </form>
                        {% endif %}
                    </td>
                {% endif %}

                {# THE RECOVERY THIS DEPLOYMENT WOULD OTHERWISE NOT HAVE. No mail is sent here, so
                   there is no "forgot password" link: an account whose generated password was
                   never written down is locked out. This generates another one, shown once. #}
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    <td>
                        {# data-turbo off: the answer RENDERS the one copy of the password, and
                           Turbo Drive discards any form response that is not a redirect. #}
                        <form method="post" data-turbo="false"
                              action="{{ path('app_team_member_password', {uuid: member.uuidString}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('team_member_password_' ~ member.uuidString) }}">
                            <button class="open-btn" type="submit"
                                    {{ stimulus_controller('confirm-modal') }}
                                    data-action="click->confirm-modal#ask"
                                    data-confirm-modal-title-value="New password for {{ member.fullName }}?"
                                    data-confirm-modal-message-value="Their current password stops working immediately. The new one is shown once, on the next screen, for you to hand over — nothing is emailed."
                                    data-confirm-modal-confirm-label-value="Generate password">Regenerate</button>
                        </form>
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr><td colspan="7"><span class="fog tm-none">Nobody on the team yet.</span></td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <p class="use"><b>Department is read-only here</b> — it follows the position. Move a position to
        another department and every holder moves with it. A position is always written
        department-first, here and in the dropdown, so two departments’ <b>Analyst</b> can never be
        picked for each other.</p>
</div>
