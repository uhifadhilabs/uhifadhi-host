{# The full create/edit screen for one position: its department, its name, its permission matrix.

   DEPARTMENT IS FIELD ONE, on create and on edit alike, and it is required — the uniqueness
   check runs against the chosen department only, so the name field cannot be answered until it
   is. Moving a position DOES re-scope its name, which is why the move belongs here, on the screen
   that owns the position whole and re-checks the name as part of the save, rather than on a row
   control that could only ever reach the unfiled holding pen. #}
{% extends 'layout.html.twig' %}

{% block title %}{{ heading }} — Uhifadhi{% endblock %}

{% block content %}
    <div class="page">
        <div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / <a href="{{ path('app_team') }}">team</a> / position</div>
        <div class="pghead">
            <div>
                <h1 class="pg">{{ heading }}</h1>
                <p class="pgsub">A position is a named bundle of permissions, owned by one department. Tick what it
                    grants; every Staff member assigned this position inherits exactly these — the action-level check is
                    the <b>PermissionVoter</b>. Its name only has to be unique <b>inside its department</b>.</p>
            </div>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="c tm-flash"><span class="acc">{{ label == 'error' ? '!' : '✓' }}</span> {{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="tm-formwrap">
            {{ form_start(form) }}
                <div class="c">
                    <span class="tab">Position<span class="src">· department + name + permissions</span></span>

                    <div class="tm-formerrors">{{ form_errors(form) }}</div>

                    <label class="matrix-label" for="tm-department"><span class="step">1</span>Department</label>
                    {# The same control on create and on edit. This screen owns the position whole,
                       so it owns its department: the row-level File control only ever offered the
                       move for an UNFILED position, which left a filed one with nowhere to go. #}
                    <select class="fld sel" id="tm-department" name="department" required>
                        <option value="" disabled {{ department or position ? '' : 'selected' }}>— choose a department —</option>
                        {% for candidate in departments %}
                            <option value="{{ candidate.uuidString }}" {{ department and department.uuidString == candidate.uuidString ? 'selected' }}>{{ candidate.name }}</option>
                        {% endfor %}
                        {# A non-empty sentinel so `required` still blocks the placeholder: the
                           controller reads anything that is not a department uuid as unfiled. #}
                        <option value="unfiled" {{ position and not department ? 'selected' }}>Unfiled — no department yet</option>
                    </select>
                    <p class="tm-hint">The name below only has to be free in <b>this</b> department. Another
                        department may already have one spelled the same way, and that is expected.
                        {% if position %}Moving this position re-checks its name against the department it
                            moves into, and every holder moves with it.{% endif %}</p>

                    <label class="matrix-label tm-spaced" for="{{ form.name.vars.id }}"><span class="step">2</span>Name</label>
                    {{ form_widget(form.name, {attr: {class: 'fld', placeholder: 'e.g. Analyst'}}) }}
                    <div class="r tm-fielderrors">{{ form_errors(form.name) }}</div>

                    <label class="matrix-label tm-spaced"><span class="step">3</span>Permissions</label>
                    <div class="matrix">
                        {% for umbrella, permissions in catalogue %}
                            <div class="umb">
                                <h4>{{ umbrella }}</h4>
                                <div class="ticks">
                                    {% for perm in permissions %}
                                        <label class="tick">
                                            <input type="checkbox" name="permissions[]" value="{{ perm.value }}"
                                                   {{ perm.value in checked ? 'checked' }}>
                                            {{ perm.action }} <em>{{ perm.value }}</em>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="tm-formfoot">
                        <a href="{{ path('app_team') }}" class="fog tm-back">← Back to team</a>
                        <button type="submit" class="cta tm-submit">
                            {{ locked ? 'Save permissions' : 'Save position' }}
                        </button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
