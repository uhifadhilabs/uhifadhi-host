{# THE ANSWER TO A REGENERATED PASSWORD: the one copy, shown once.

   Same shape and same rules as the credentials panel on the create screen — nothing is emailed
   in this deployment, so the handover is the admin reading the password out. This screen is the
   response to the POST itself (never a redirect, which would throw the password away), so it
   carries no form: there is nothing left to submit. #}
{% extends 'layout.html.twig' %}

{% block title %}New password — Uhifadhi{% endblock %}

{% block content %}
    <div class="page">
        <div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / <a href="{{ path('app_team') }}">team</a> / password</div>
        <div class="pghead">
            <div>
                <h1 class="pg">New password</h1>
                <p class="pgsub">Give this to <b>{{ member.fullName }}</b> now. It is not stored in readable
                    form and this page will not show it again — if it is lost, generate another one from the
                    roster. Their previous password stopped working the moment this was made.</p>
            </div>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="c tm-flash"><span class="acc">{{ label == 'error' ? '!' : '✓' }}</span> {{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="tm-formwrap">
            <div class="c tm-cred">
                <span class="tab">Credentials<span class="src">· shown once</span></span>
                <dl class="tm-credlist">
                    <dt>Email</dt>
                    <dd class="mono">{{ member.email }}</dd>
                    <dt>Password</dt>
                    <dd class="mono" data-generated-password>{{ password }}</dd>
                    <dt>Tier</dt>
                    <dd><span class="tier t-{{ member.teamRole.value }}">{{ member.teamRole.label }}</span></dd>
                    <dt>Position</dt>
                    <dd>
                        {% if member.teamRole.canManageContent %}
                            <span class="fog mono tm-none">— by tier</span>
                        {% elseif member.position %}
                            <b>{{ member.position.department ? member.position.department.name : 'Unfiled' }}</b>
                            / {{ member.position.name }}
                        {% else %}
                            <span class="fog mono tm-none">unassigned</span>
                        {% endif %}
                    </dd>
                </dl>

                <div class="tm-formfoot">
                    <a href="{{ path('app_team') }}" class="fog tm-back">← Back to team</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
