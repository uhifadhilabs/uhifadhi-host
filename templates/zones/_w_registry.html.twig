{# The dense register — the "Registry first" direction, in the shape of the areas table.

   A register this wide never fits a narrow cell, so it scrolls INSIDE its own plate (.ztblwrap) and
   the page never scrolls sideways. Every row is navigable and says so twice: the cursor, and the
   visible "Open →" in its trailing column.

   → ZoneRepository::zonesFor($area); rename and delete are the same two routes the detail pane uses,
     so a manager never learns a second way to do one thing.

   The design's patrols / incidents / posts columns are the modules' numbers, not the host's — no
   module ships a per-zone count yet, so those columns are absent rather than zero-filled. #}
<div data-w="registry">
    <div class="c">
        <span class="tab"><span class="idx">PL·47</span>All zones<span class="src">· zone · {{ zones|length }} · non-overlapping</span></span>
        <span class="lib">register table</span>
        <div class="ztblwrap">
            <table class="tbl ztable">
                <thead>
                <tr>
                    <th>Zone</th>
                    <th>plate</th>
                    <th style="text-align:right">km²</th>
                    <th style="text-align:right">% of AOI</th>
                    <th style="text-align:right">vertices</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for row in zones %}
                    <tr data-zone-uuid="{{ row.uuid }}">
                        <td>
                            <div style="display:flex;gap:11px;align-items:center">
                                <span class="sw" style="background:{{ row.color }};width:14px;height:14px"></span>
                                <div>
                                    <div style="font-size:13.5px;font-weight:600" data-zone-name>{{ row.name }}</div>
                                    <div class="mono" style="font-size:9px;color:rgb(var(--c-dim));margin-top:2px">{{ row.vertices }} vertices · MultiPolygon</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="zn">{{ row.plate }}</span></td>
                        <td class="num">{{ row.areaKm2|number_format(1) }}</td>
                        <td class="num">{{ row.sharePct|number_format(1) }}%</td>
                        <td class="num">{{ row.vertices }}</td>
                        <td>
                            <div class="acts">
                                <a class="open-btn" href="{{ path('app_area_zone', {uuid: area.uuid, zoneUuid: row.uuid}) }}"
                                   title="Open “{{ row.name }}”">Open {{ ux_icon('lucide:chevron-right') }}</a>
                                {% if canManage %}
                                    {# Editing a name happens in the detail pane, which is where the
                                       "unique within this area" rule is stated — a pencil that opened
                                       an inline field here would drop that sentence. #}
                                    <a class="iconbtn" title="Rename “{{ row.name }}”"
                                       href="{{ path('app_area_zone', {uuid: area.uuid, zoneUuid: row.uuid}) }}#detail">{{ ux_icon('lucide:pencil') }}</a>
                                    <form method="post" data-zone-delete
                                          action="{{ path('app_area_zone_delete', {uuid: area.uuid, zoneUuid: row.uuid}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('zone_manage') }}">
                                        <button type="submit" class="iconbtn dg" title="Delete “{{ row.name }}”"
                                                {{ stimulus_controller('confirm-modal') }}
                                                data-action="click->confirm-modal#ask"
                                                data-confirm-modal-title-value="Delete “{{ row.name }}”?"
                                                data-confirm-modal-message-value="The zone is removed from {{ area.name }}. No record is deleted with it — everything it grouped stays exactly where it is, and simply stops being grouped under this name. This cannot be undone."
                                                data-confirm-modal-confirm-label-value="Delete zone"
                                                data-confirm-modal-danger-value="true">{{ ux_icon('lucide:trash-2') }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="rln" style="margin-top:10px;border-bottom:0;padding-top:11px">
            <span class="mono d" style="font-size:10.5px">{{ zones|length }} zones · {{ zonedKm2|number_format(0) }} km² · {{ coveragePct|number_format(1) }}% covered · no overlaps</span>
        </div>
    </div>
</div>
