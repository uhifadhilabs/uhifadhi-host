{# AO·03 · THE OPERATIONAL CENTREPIECE.

   One plate, many owners: the boundary and the zones are the host's, and everything operational on
   it — today's tracks, the live positions, the open incidents — is a layer contributed by the
   module that owns the data. The host neither knows nor caches what any of them mean.

   WHAT IS ON BY DEFAULT IS OPERATIONAL. What is off by default is scientific, and it is in the
   legend with its own entry: demoted, never deleted, one click away exactly where it was.
   → Uhifadhi\Overview\MapLayerProviderInterface #}
<div class="c" {{ stimulus_controller('overview-map', {layers: layers|map(l => {id: l.id, swatch: l.swatch, style: l.style, on: l.on, features: l.features})}) }}
     data-action="overview:layers->overview-map#adopt">
    <span class="tab">
        <span class="idx">AO·03</span>Where
        {%- if layers|filter(l => l.live)|length %}<span class="src">· <span class="ao-live"><i></i>live</span></span>{% endif -%}
        <span class="src">· {{ now|date('j M H:i') }}</span>
    </span>
    {{ include('area/overview/_ao_by.html.twig', {slug: 'host', who: 'host plate · module layers'}, with_context: false) }}

    <div class="map-frame" data-overview-map-target="frame">
        <div class="viewer ao-plate">
            <div class="ao-mapcanvas" data-overview-map-target="canvas"></div>
        </div>
    </div>

    {{ include('area/overview/_legend.html.twig', {legend: legend}, with_context: false) }}
</div>
