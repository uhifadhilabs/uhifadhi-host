{# AO·06 · THE AREA PULSE — one stream, every module.

   The pulse is not a log of records: it is a log of MOVES — a patrol opened, an incident changed
   state, an observation logged. Every module already keeps one, and they all have the same shape,
   which is why one component draws all of them and why a new module needs no work here.
   → Uhifadhi\Overview\PulseProviderInterface #}
{% set total = pulse|reduce((c, day) => c + day.events|length, 0) %}
<div class="c">
    <span class="tab"><span class="idx">AO·06</span>Area pulse<span class="src">· since {{ now|date_modify(constant('Uhifadhi\\Service\\AreaOverviewComposer::PULSE_SINCE'))|date('j M H:i') }} · {{ total }} event{{ total == 1 ? '' : 's' }}</span></span>
    {{ include('area/overview/_ao_by.html.twig', {slug: 'host', who: 'host · the move log'}, with_context: false) }}

    {% if total == 0 %}
        <div class="use">Nothing moved in this window. The pulse shows what happened while you were away, so an empty
            stream is a quiet night rather than a missing feed.</div>
    {% else %}
        <div class="use ao-lede">Every module writes the same kind of row — a move, a time, a person.
            That is why one component draws all of them, and why a new module needs no work here.</div>
        {% for day in pulse %}
            {# The day's own count, and what it is made of. The host counts by CONTRIBUTOR, because
               that is the only breakdown it can make without knowing what any module's moves mean. #}
            {% set byModule = {} %}
            {% for event in day.events %}
                {% set byModule = byModule|merge({(event.moduleLabel): (byModule[event.moduleLabel]|default(0)) + 1}) %}
            {% endfor %}
            <div class="i-day">
                <b>{{ day.day|date('D j M')|lower }}</b>
                <span class="cnt">{{ day.events|length }} event{{ day.events|length == 1 ? '' : 's' }}{% for label, n in byModule %} · {{ n }} {{ label|lower }}{% endfor %}</span>
            </div>
            {% for event in day.events %}
                <a class="i-feed" href="{{ event.url }}">
                    {# THE AGE IS WHY THE STREAM READS AS "WHILE YOU WERE AWAY". A clock time alone
                       makes a person do the subtraction. #}
                    {% set mins = ((now.timestamp - event.at.timestamp) / 60)|round(0, 'floor') %}
                    <span class="gut">
                        <span class="hm">{{ event.at|date('H:i') }}</span>
                        <span class="ago">{{ mins < 60 ? mins ~ ' min' : (mins < 1440 ? (mins // 60) ~ ' h' : (mins // 1440) ~ ' d') }}</span>
                    </span>
                    <span class="mark"><i style="background:{{ event.swatch }}"></i></span>
                    <span class="bd">
                        <span class="hl">
                            <span class="id">{{ event.recordRef }}</span>
                            <span class="ao-move{{ event.stateClass ? ' ' ~ event.stateClass }}">{{ event.move }}</span>
                        </span>
                        <span class="tt">{{ event.summary }}</span>
                        <span class="mt"><span>{{ event.moduleLabel|lower }}</span>{% for fact in event.meta %}<span>{{ fact }}</span>{% endfor %}</span>
                    </span>
                </a>
            {% endfor %}
        {% endfor %}
    {% endif %}
</div>
