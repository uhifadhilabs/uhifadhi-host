{% extends 'layout.html.twig' %}

{% block title %}Forest loss — Ngorongoro{% endblock %}
{% block heading %}Forest loss{% endblock %}

{% block chips %}
    {% set chips = [
        { value: (stats.totalLossHa|number_format) ~ ' ha', label: 'total loss' },
        { value: stats.yearFrom ~ '–' ~ stats.yearTo, label: 'Hansen GFC years' },
        { value: (stats.boundaryKm2|number_format) ~ ' km²', label: stats.boundaryName },
    ] %}
    {% for chip in chips %}
        <div class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-1.5 leading-tight">
            <span class="block text-sm font-semibold tabular-nums text-forest-600">{{ chip.value }}</span>
            <span class="block text-[11px] text-gray-500">{{ chip.label }}</span>
        </div>
    {% endfor %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('leaflet/leaflet.css') }}">
{% endblock %}

{% block javascripts %}
    {# Self-hosted Leaflet UMD → window.L. Classic (non-module) script, so it runs
       before the deferred importmap module and is ready when the controller
       connects. Leaflet over MapLibre on purpose — see map_controller.js. #}
    <script src="{{ asset('leaflet/leaflet.js') }}"></script>
    {{ parent() }}
{% endblock %}

{% block content %}
    <div
        class="absolute inset-0"
        data-controller="map"
        data-map-boundary-value="{{ boundary|json_encode|e('html_attr') }}"
        data-map-forest-loss-url-value="{{ path('forest_loss_geojson') }}"
    >
        {# `isolate` contains Leaflet's internal z-indexes (up to ~1000) in their own
           stacking context, so the sibling panel's z-10 reliably sits above the map. #}
        <div id="map" class="absolute inset-0 isolate" data-map-target="canvas"></div>

        <div class="absolute left-4 top-4 z-10 w-60 rounded-xl bg-white/95 p-3.5 shadow-lg backdrop-blur">
            <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Base map</p>
            <div class="mb-4 flex overflow-hidden rounded-lg border border-gray-300 text-sm">
                <button type="button" data-base="osm" data-action="map#showBase" class="flex flex-1 items-center justify-center gap-1.5 py-1.5">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
                    Map
                </button>
                <button type="button" data-base="satellite" data-action="map#showBase" class="flex flex-1 items-center justify-center gap-1.5 bg-forest-500 py-1.5 text-white">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M13 7 9 3 5 7l4 4"/><path d="m17 11 4 4-4 4-4-4"/><path d="m8 12 4 4 6-6-4-4Z"/><path d="m16 8 3-3"/><path d="M9 21a6 6 0 0 0-6-6"/></svg>
                    Satellite
                </button>
            </div>

            <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Loss years</p>
            {# One dual-handle slider: two stacked native range inputs (thumbs only —
               see the range-thumb utility) over a shared track + selected-range fill. #}
            <div class="relative h-6">
                <div class="absolute top-1/2 h-1.5 w-full -translate-y-1/2 rounded-full bg-gray-200"></div>
                <div class="absolute top-1/2 h-1.5 -translate-y-1/2 rounded-full bg-forest-500"
                     data-map-target="rangeFill" style="left: 0%; width: 100%;"></div>
                <input type="range" min="2001" max="2023" step="1" value="2001" aria-label="From year"
                       data-map-target="fromYear" data-action="input->map#filterYears"
                       class="range-thumb absolute inset-0 w-full">
                <input type="range" min="2001" max="2023" step="1" value="2023" aria-label="To year"
                       data-map-target="toYear" data-action="input->map#filterYears"
                       class="range-thumb absolute inset-0 w-full">
            </div>
            <p class="mt-1 text-center text-[12px] tabular-nums text-gray-600" data-map-target="rangeSummary">
                2001–2023 · {{ stats.totalLossHa|number_format }} ha
            </p>

            {% if lossByYear is not empty %}
                <div class="mt-4">
                    <p class="mb-1 flex items-baseline justify-between text-[11px] font-semibold uppercase tracking-wide text-gray-500">
                        Loss by year <span class="font-normal normal-case tracking-normal text-gray-400">√ ha</span>
                    </p>
                    {# Square-root scale: the 2001 Hansen artifact (~1,657 ha) would flatten
                       every other year on a linear scale. #}
                    <div class="flex h-12 items-end gap-px">
                        {% for row in lossByYear %}
                            <div
                                class="min-h-0.5 flex-1 cursor-pointer rounded-t-[1px] transition-opacity hover:outline hover:outline-1 hover:outline-forest-700"
                                data-map-target="bar"
                                data-year="{{ row.year }}"
                                data-ha="{{ row.ha }}"
                                data-action="click->map#focusYear mouseenter->map#highlightYear mouseleave->map#unhighlightYear"
                                title="{{ row.year }} — {{ row.ha|number_format }} ha{{ row.year == 2001 ? ' (includes Hansen baseline artifact)' : '' }}"
                                style="height: {{ maxLossHa > 0 ? max(2, ((row.ha / maxLossHa) ** 0.5 * 48)|round) : 2 }}px; background: {{ row.color }};"
                            ></div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="mt-3.5">
                <div class="loss-ramp h-2 rounded"></div>
                <div class="mt-0.5 flex justify-between text-[11px] text-gray-500"><span>2001</span><span>2012</span><span>2023</span></div>
                <div class="mt-2.5 flex items-center gap-2 text-sm text-gray-700">
                    <i class="inline-block w-4 border-t-[3px] border-forest-500 shadow-[0_0_0_1px_#fff]"></i> NCA boundary
                </div>
            </div>
        </div>
    </div>
{% endblock %}
