<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Uhifadhi{% endblock %}</title>
        {# Same mark as the sidebar logo (public/icon.svg) — one source, consistent. #}
        <link rel="icon" href="{{ asset('icon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('icon.svg') }}">

        {# Theme (light default; opt-in dark) is applied by the `theme` Stimulus
           controller on the top bar — see assets/controllers/theme_controller.js. #}

        {# Design-system fonts: Archivo (display) · JetBrains Mono (data / labels). #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    {# One place the whole platform reads its satellite imagery from — the map
       module's seam. Every map controller, the host's own and every module's,
       reads this one attribute, so a layer cannot draw one way on an area page
       and another inside a module. What it says is whatever config/packages/map.yaml
       configured: esri, google (with its key) or a deployment's own source.

       No env var is named here any more, and no key is published on a page whose
       provider would not use one. #}
    <body {{ map_basemap_attributes() }}>
        {% block body %}{% endblock %}
    </body>
</html>