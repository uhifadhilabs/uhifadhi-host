{# Department detail widget 'identity' — the address this record lives at.
   Design: overview.widgets.js → "identity" (DP·00). The uuid is stated, not linked: the uuid
   IS the page. #}
<div class="c" data-w="identity">
    <span class="tab"><span class="idx">DP·00</span>Department<span class="src">· org-wide</span></span>
    <div class="railid">
        <span class="mark">{{ department.name|split(' ')|map(w => w|first)|join|slice(0, 2)|upper }}</span>
        <h2>{{ department.name }}</h2>
        <div class="railid-plates"><span class="idplate"><b>DP</b>org-wide</span></div>
        <div class="uuid">{{ department.uuidString }}</div>
        <div class="railstat">
            <div><b>{{ department.modules|length }}</b><span>Module{{ department.modules|length == 1 ? '' : 's' }}</span></div>
            <div><b>{{ positions|length }}</b><span>Position{{ positions|length == 1 ? '' : 's' }}</span></div>
            <div><b>{{ members|length }}</b><span>{{ members|length == 1 ? 'Person' : 'People' }}</span></div>
        </div>
    </div>
</div>
