{% extends 'layout.html.twig' %}

{% block title %}New area — Uhifadhi{% endblock %}
{% block heading %}New area{% endblock %}

{% block content %}
    <div class="h-full overflow-y-auto p-6">
        <div class="mx-auto max-w-lg rounded-xl border border-gray-200 bg-white p-8">
            {{ form_start(form) }}
                <div class="mb-4 text-sm text-red-600">{{ form_errors(form) }}</div>
                <div class="mb-5">
                    {{ form_label(form.name, null, {label_attr: {class: 'mb-1.5 block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.name, {attr: {class: 'w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-forest-500 focus:outline-none focus:ring-1 focus:ring-forest-500', placeholder: 'e.g. Ngorongoro Conservation Area'}}) }}
                    <div class="mt-1 text-sm text-red-600">{{ form_errors(form.name) }}</div>
                </div>

                <div class="mb-6">
                    {{ form_label(form.boundaryFile, null, {label_attr: {class: 'mb-1.5 block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.boundaryFile, {attr: {class: 'w-full rounded-lg border border-gray-300 text-sm file:mr-3 file:rounded-l-lg file:border-0 file:bg-forest-50 file:px-4 file:py-2.5 file:text-sm file:font-medium file:text-forest-700 hover:file:bg-forest-100'}}) }}
                    <p class="mt-1.5 text-xs text-gray-500">{{ form.boundaryFile.vars.help }}</p>
                    <div class="mt-1 text-sm text-red-600">{{ form_errors(form.boundaryFile) }}</div>
                </div>

                <div class="flex items-center justify-between">
                    <a href="{{ path('dashboard_index') }}" class="text-sm text-gray-500 hover:text-gray-700">← Back to areas</a>
                    <button type="submit" class="rounded-lg bg-forest-500 px-5 py-2 text-sm font-medium text-white hover:bg-forest-600">Import boundary</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
