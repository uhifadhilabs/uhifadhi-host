{# Settings tab — the module's ONE Data + Visualizations page (matches the design's Settings page):
   how the module is fed (run ingestion, map detail, runs, datasets, bindings) AND how it is drawn
   (the visualization list + configure modal), together. `visualizations` = this module's charts,
   `configureViz` = the viz being configured via ?configure, `vizColumns` = bindable dataset columns. #}
<h2 class="zone">Data</h2>
<div class="grid g2">
    <div class="c">
        <span class="tab"><span class="idx">SET·01</span>Fetch the data<span class="src">· engine</span></span>
        <div class="rln"><span>Map is drawn at</span>
            <span class="mono d">{% if mapDetail %}~{{ mapDetail.metres }} m{% else %}not fetched yet{% endif %}</span></div>
        <div class="rln"><span>Last updated</span>
            <span class="chip {{ lastRun and lastRun.status == 'succeeded' ? 'ok' : (lastRun and lastRun.status == 'running' ? 'warn' : 'idle') }}">{{ lastRun ? (lastRun.status == 'succeeded' ? 'up to date' : lastRun.status) : 'never' }}</span></div>
        {% if is_granted('ingestion.run') %}
            <form method="post" action="{{ path('dashboard_area_module_run', {uuid: area.uuid, module: module.slug}) }}" style="margin-top:15px">
                <input type="hidden" name="_token" value="{{ csrf_token('module_run_' ~ module.slug) }}">
                <label class="mono" style="font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:rgb(var(--c-fog));display:block;margin-bottom:6px">How finely to draw the map</label>
                <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                    <select name="detail" class="rdf-cf" style="width:auto;margin:0;padding:7px 10px;font-size:12px">
                        {% set cur = mapDetail ? mapDetail.factor : 4 %}
                        <option value="2"{{ cur == 2 ? ' selected' }}>Sharp (~60 m) — slower to load</option>
                        <option value="4"{{ cur == 4 ? ' selected' }}>Balanced (~120 m)</option>
                        <option value="8"{{ cur == 8 ? ' selected' }}>Simple (~240 m) — faster</option>
                    </select>
                    <button type="submit" class="cta" style="border:0;cursor:pointer;padding:9px 18px">Fetch &amp; update</button>
                </div>
                <div class="use">Downloads the source imagery and computes this area's data. The setting only affects how sharp the coloured map looks — the areas and statistics are exact either way.</div>
            </form>
        {% else %}
            <div class="use">Updating the data needs the Ingestion permission.</div>
        {% endif %}
    </div>

    <div class="c">
        <span class="tab"><span class="idx">SET·02</span>Recent runs<span class="src">· dataset_run</span></span>
        {% if moduleRuns is empty %}
            <p class="fog" style="font-size:12px;margin-top:8px">No runs yet.</p>
        {% else %}
            <div style="margin-top:6px">
                {% for run in moduleRuns %}
                    <div class="rln"><span>#{{ run.id }}
                        {% if run.finishedAt %}<span class="mono d" style="font-size:9px">{{ run.finishedAt|date('M j, H:i') }}</span>{% endif %}</span>
                        <span class="chip {{ run.status == 'succeeded' ? 'ok' : (run.status == 'running' ? 'warn' : 'fail') }}">{{ run.status }}</span></div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<div class="grid g2" style="margin-top:20px">
    <div class="c">
        <span class="tab"><span class="idx">SET·03</span>Datasets<span class="src">· module_dataset</span></span>
        {% if moduleDatasets is empty and not hasMapLayer %}
            <p class="fog" style="font-size:12px;margin-top:8px">No datasets yet — fetch the data above.</p>
        {% else %}
            <div style="margin-top:6px">
                {% for d in moduleDatasets %}
                    <div class="rln"><span>{{ d.key }}</span><span class="mono d">{{ d.kind.value }} · {{ d.rows|length }} rows</span></div>
                {% endfor %}
                {% if hasMapLayer %}
                    <div class="rln"><span>{{ module.slug }}_map</span><span class="mono d">vector · PostGIS layer</span></div>
                {% endif %}
            </div>
        {% endif %}
        <div class="use">The data this module owns on this area. Re-running replaces it in place.</div>
    </div>

    <div class="c">
        <span class="tab"><span class="idx">SET·04</span>Chart bindings<span class="src">· visualization</span></span>
        {% if visualizations is empty %}
            <p class="fog" style="font-size:12px;margin-top:8px">No charts yet — add one in Visualizations below.</p>
        {% else %}
            <div style="margin-top:6px">
                {% for v in visualizations %}
                    <div class="rln"><span><b>{{ v.title }}</b><span class="chip idle" style="margin-left:6px">{{ v.type.label }}</span></span>
                        <span class="mono d" style="font-size:10px">{{ v.datasetKey ?: 'unbound' }}{% if v.datasetKey %} · x={{ v.xAxis }} y={{ v.yAxis }}{% endif %}</span></div>
                {% endfor %}
            </div>
        {% endif %}
        <div class="use">Which chart plots which dataset column. Configure each one in Visualizations below.</div>
    </div>
</div>

<h2 class="zone" style="margin-top:30px">Visualizations</h2>
<div class="fog" style="font-size:12px;margin:-8px 0 16px">Each row is a chart — its type, the dataset &amp; columns it plots, and its order. Configure opens the editor; drag the handle to reorder.</div>
<div class="c" style="padding:0;overflow:hidden"
     {{ stimulus_controller('module_order') }}
     data-module-order-url-value="{{ path('dashboard_area_viz_reorder', {uuid: area.uuid, module: module.slug}) }}"
     data-module-order-token-value="{{ csrf_token('viz_reorder_' ~ module.slug) }}">
    {% for v in visualizations %}
        <div class="viz-row" data-module-order-target="row" data-uuid="{{ v.uuidString }}">
            {% if is_granted('module.create') %}<span class="grip" data-module-order-target="handle" title="drag to reorder">{{ ux_icon('lucide:grip-vertical', {width: 15, height: 15}) }}</span>{% endif %}
            <span class="viz-row-title">{{ v.title }}</span>
            <span class="chip idle">{{ v.type.label }}</span>
            <span class="mono d viz-row-bind">{{ v.datasetKey ?: 'unbound' }}{% if v.datasetKey %} · x={{ v.xAxis }} y={{ v.yAxis }}{% endif %}</span>
            {% if is_granted('module.create') %}
                <a href="{{ path('dashboard_area_module', {uuid: area.uuid, module: module.slug, tab: 'settings', configure: v.uuidString}) }}" class="mono viz-row-cfg">Configure</a>
                <form method="post" action="{{ path('dashboard_area_viz_delete', {uuid: area.uuid, module: module.slug, vizUuid: v.uuidString}) }}" style="display:inline" data-turbo-confirm="Remove “{{ v.title }}”?">
                    <input type="hidden" name="_token" value="{{ csrf_token('viz_delete_' ~ v.uuidString) }}">
                    <button type="submit" class="viz-rm" title="remove">×</button>
                </form>
            {% endif %}
        </div>
    {% else %}
        <div style="padding:22px 15px;text-align:center"><span class="fog" style="font-size:12.5px">No visualizations yet.</span></div>
    {% endfor %}
    {% if is_granted('module.create') %}
        <form method="post" action="{{ path('dashboard_area_viz_add', {uuid: area.uuid, module: module.slug}) }}" class="viz-add-row">
            <input type="hidden" name="_token" value="{{ csrf_token('viz_add_' ~ module.slug) }}">
            <button type="submit">{{ ux_icon('lucide:plus', {width: 14, height: 14}) }} Add visualization</button>
        </form>
    {% endif %}
</div>

{# Configure-visualization modal — overlays THIS Settings page (?configure=<uuid>), one page throughout. #}
{% if configureViz %}
    {% set v = configureViz %}
    {% set closeUrl = path('dashboard_area_module', {uuid: area.uuid, module: module.slug, tab: 'settings'}) %}
    <div class="modal-scrim">
        <div class="modal">
            <div class="modal-head">
                <div>
                    <div class="modal-title">Configure visualization</div>
                    <div class="fog" style="font-size:11.5px">{{ v.title }} · {{ module.label }} module</div>
                </div>
                <a class="modal-x" href="{{ closeUrl }}" title="Close">×</a>
            </div>
            <div class="modal-body">
                <form method="post" action="{{ path('dashboard_area_viz_update', {uuid: area.uuid, module: module.slug, vizUuid: v.uuidString}) }}" style="display:flex;flex-direction:column;gap:12px">
                    <input type="hidden" name="_token" value="{{ csrf_token('viz_update_' ~ v.uuidString) }}">
                    <label class="viz-field">Title<input class="fld" name="title" value="{{ v.title }}"></label>
                    <label class="viz-field">Type<select class="fld" name="type">
                        {% for t in vizTypes %}<option value="{{ t.value }}" {{ v.type == t ? 'selected' }}>{{ t.label }}</option>{% endfor %}
                    </select></label>
                    <label class="viz-field">X axis<select class="fld" name="xAxis">
                        {% for a in vizColumns %}<option {{ v.xAxis == a ? 'selected' }}>{{ a }}</option>{% endfor %}
                    </select></label>
                    <label class="viz-field">Y axis<select class="fld" name="yAxis">
                        {% for a in vizColumns %}<option {{ v.yAxis == a ? 'selected' }}>{{ a }}</option>{% endfor %}
                    </select></label>
                    <label class="viz-field">Colour by<select class="fld" name="colourBy">
                        <option {{ (v.colourBy ?? '') == '' ? 'selected' }}>— none —</option>
                        {% for a in vizColumns %}<option {{ v.colourBy == a ? 'selected' }}>{{ a }}</option>{% endfor %}
                    </select></label>
                    <label class="viz-field">Aggregation<select class="fld" name="aggregation">
                        {% for g in ['None', 'Sum', 'Mean', 'Max'] %}<option {{ v.aggregation == g ? 'selected' }}>{{ g }}</option>{% endfor %}
                    </select></label>
                    <div style="display:flex;align-items:center;gap:12px;margin-top:6px">
                        <a href="{{ closeUrl }}" class="fog" style="font-size:12px;text-decoration:none">Cancel</a>
                        <button type="submit" class="cta" style="margin-left:auto">Apply</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}
