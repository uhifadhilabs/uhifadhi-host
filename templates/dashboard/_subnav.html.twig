{#- Area sub-app modules: every module is a live link (Overview → the hub), planned
    modules are inert. `active` is the current module slug ('overview' on the hub).
    Whitespace is trimmed so the modules render as one clean row in the source. -#}
<div class="subnav">
{%- for m in modules %}
    {%- if m.slug == 'overview' -%}
        <a href="{{ path('dashboard_area_show', {uuid: area.uuid}) }}"{{ active == 'overview' ? ' class="on"' : '' }}>{{ m.label }}</a>
    {%- else -%}
        <a href="{{ path('dashboard_area_module', {uuid: area.uuid, module: m.slug}) }}"{{ active == m.slug ? ' class="on"' : '' }}>{{ m.label }}</a>
    {%- endif -%}
{% endfor -%}
{%- for p in planned -%}
    <span class="off">{{ p.label }}</span>
{%- endfor -%}
</div>
