{# A module's map — the SAME Leaflet base as the area Overview (satellite/map toggle, AOI boundary,
   zoom, fullscreen, dim), reusing map_controller. When `classLayerUrl` is given, the controller also
   draws the dissolved per-class layer (PostGIS → geojson), coloured by `classPalette` (label→hex).
   Params: boundary, mapId, height (default 380px), classLayerUrl?, classPalette?. #}
{% set mapId = mapId|default('modmap') %}
{% set height = height|default('380px') %}
<div class="map-frame" data-map-target="frame"
     data-controller="map"
     data-map-boundary-value="{{ boundary|json_encode|e('html_attr') }}"
     {% if classLayerUrl is defined and classLayerUrl %}data-map-class-layer-url-value="{{ classLayerUrl }}"{% endif %}
     {% if classPalette is defined and classPalette %}data-map-class-palette-value="{{ classPalette|json_encode|e('html_attr') }}"{% endif %}
     {% if rasterUrl is defined and rasterUrl %}data-map-raster-url-value="{{ rasterUrl }}" data-map-raster-bounds-value="{{ rasterBounds|json_encode|e('html_attr') }}"{% endif %}>
    <div class="map-view" style="position:relative;height:{{ height }};border-radius:10px;overflow:hidden">
        {# isolation:isolate contains Leaflet's high-z panes so the top-right controls (z-index:10) stay on top. #}
        <div id="{{ mapId }}" data-map-target="canvas" style="position:absolute;inset:0;isolation:isolate"></div>
        <div style="position:absolute;top:10px;right:10px;z-index:10;display:flex;gap:6px;align-items:flex-start">
            <button type="button" class="map-pill on" data-map-target="dimBtn" data-action="map#toggleDim" title="Dim outside the boundary">DIM&nbsp;ON</button>
            <button type="button" class="map-btn" data-action="map#expand" title="Expand map" aria-label="Expand map">{{ ux_icon('lucide:maximize') }}</button>
            <div class="map-toggle">
                <button type="button" class="on" data-base="satellite" data-action="map#showBase">Satellite</button>
                <button type="button" data-base="osm" data-action="map#showBase">Map</button>
            </div>
        </div>
        {# The legend rides INSIDE the frame so fullscreen carries it; `legendVisible` also shows
           it in the normal view (Overview — Explore's rail card covers the normal view instead). #}
        {% set legendClass = 'map-legend' ~ (legendVisible|default(false) ? ' show' : '') %}
        {% if legend is defined and legend is not empty %}
            <div class="{{ legendClass }}">
                {% for item in legend %}
                    <div class="row">
                        <span class="sw" style="background:{{ item.color }}"></span>
                        <span class="lb">{{ item.label }}</span>
                        {% if item.value %}<span class="vl">{{ item.value }}</span>{% endif %}
                    </div>
                {% endfor %}
            </div>
        {% elseif rasterLegend is defined and rasterLegend %}
            <div class="{{ legendClass }}">
                <p class="ttl">{{ rasterLegend.label }}</p>
                {% set stops = [] %}
                {% for stop in rasterLegend.ramp %}{% set stops = stops|merge(['%s %d%%'|format(stop[1], stop[0] * 100)]) %}{% endfor %}
                <div class="bar" style="background:linear-gradient(90deg, {{ stops|join(', ') }})"></div>
                <div class="ends">
                    <span>{{ rasterLegend.min }}{{ rasterLegend.unit is defined ? ' ' ~ rasterLegend.unit }}{% if rasterLegend.low is defined %}<br>{{ rasterLegend.low }}{% endif %}</span>
                    <span>{{ rasterLegend.max }}{{ rasterLegend.unit is defined ? ' ' ~ rasterLegend.unit }}{% if rasterLegend.high is defined %}<br>{{ rasterLegend.high }}{% endif %}</span>
                </div>
            </div>
        {% endif %}
    </div>
</div>
