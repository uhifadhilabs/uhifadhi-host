{% extends 'layout.html.twig' %}

{% block title %}{{ area.name }} — Uhifadhi{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('leaflet/leaflet.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('leaflet/leaflet.js') }}"></script>
    {{ parent() }}
{% endblock %}

{% block content %}
    <div class="page">
        <div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / <a href="{{ path('dashboard_index') }}">areas</a> / {{ area.name|lower }}</div>
        <div class="pghead">
            <div>
                <h1 class="pg">{{ area.name }}</h1>
                <p class="pgsub">The park hub — identity and the live map. Its analytical modules live on the Modules tab.</p>
            </div>
        </div>

        {{ include('dashboard/_area_tabs.html.twig', {area: area, active: 'overview'}) }}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="c" style="padding:12px 16px;margin-bottom:16px"><span class="acc">✓</span> {{ message }}</div>
            {% endfor %}
        {% endfor %}

        {# ── KPI plates ─────────────────────────────────────────────────── #}
        <div class="grid g2">
            <div class="c kpi"><span class="tab"><span class="idx">PL·10</span>Area</span>
                <b class="disp">{{ stats.areaKm2|number_format }}<em>km²</em></b><span class="sub">ST_Area geography</span></div>
            <div class="c kpi"><span class="tab"><span class="idx">PL·11</span>Modules</span>
                <b class="disp">{{ stats.modules ?: '—' }}</b><span class="sub">switched on for this area</span></div>
        </div>

        {# ── The live map + annual loss + ingestion (one map controller over the map) ─ #}
        <div class="grid g32"
             data-controller="map"
             data-map-boundary-value="{{ boundary|json_encode|e('html_attr') }}">
            <div class="c" id="nca-map" style="padding-top:26px">
                <span class="tab"><span class="idx">PL·14</span>Boundary<span class="src">· Esri imagery · WDPA boundary</span></span>
                <span class="lib">leaflet in-app</span>
                {# The whole frame (map + controls) is what expands, so the dim
                   toggle stays usable in full screen. #}
                <div class="map-frame" data-map-target="frame">
                <div class="map-view" style="position:relative;height:380px;border-radius:10px;overflow:hidden">
                    <div id="map" class="absolute inset-0 isolate" data-map-target="canvas" style="position:absolute;inset:0"></div>

                    {# No controls written here: the platform chrome module
                       (assets/map_chrome.js) builds zoom, DIM, the base-layer
                       menu and fullscreen into this frame, so the area map and
                       every module map wear exactly the same instrument and
                       neither repo keeps a second copy of the markup. #}
                </div>

                </div>{# /.map-frame #}

                <div class="use"><b>The real thing</b>: satellite mosaic and the WDPA boundary from the database. Module layers ride on top as their bundles ship them.</div>
                <span class="stamp">EPSG:4326 · aoi #{{ area.id }}</span>
            </div>

        </div>
    </div>
{% endblock %}
