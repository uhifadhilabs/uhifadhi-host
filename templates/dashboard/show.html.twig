{% extends 'layout.html.twig' %}

{% block title %}{{ area.name }} — Uhifadhi{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('leaflet/leaflet.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('leaflet/leaflet.js') }}"></script>
    {{ parent() }}
    {% if hasRunningRun %}
        {# A run is in flight — refresh so status and map follow it. #}
        <meta http-equiv="refresh" content="6">
    {% endif %}
{% endblock %}

{% block content %}
    <div class="page">
        <div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / <a href="{{ path('dashboard_index') }}">areas</a> / {{ area.name|lower }}</div>
        <div class="pghead">
            <div>
                <h1 class="pg">{{ area.name }}</h1>
                <p class="pgsub">The park hub — identity, the live map, and one door per analytical module.</p>
            </div>
            {% if is_granted('module.create') %}
                <div class="pgact"><a class="cta" href="{{ path('dashboard_area_modules', {uuid: area.uuid}) }}">{{ ux_icon('lucide:sliders-horizontal') }}Customize modules</a></div>
            {% endif %}
        </div>

        {{ include('dashboard/_subnav.html.twig', {area: area, active: 'overview', modules: modules, planned: planned}) }}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="c" style="padding:12px 16px;margin-bottom:16px"><span class="acc">✓</span> {{ message }}</div>
            {% endfor %}
        {% endfor %}

        {# ── KPI plates ─────────────────────────────────────────────────── #}
        <div class="grid g4">
            <div class="c kpi"><span class="tab"><span class="idx">PL·10</span>Area</span>
                <b class="disp">{{ stats.areaKm2|number_format }}<em>km²</em></b><span class="sub">ST_Area geography</span></div>
            <div class="c kpi hot"><span class="tab"><span class="idx">PL·11</span>Forest lost</span>
                <b class="disp">{% if stats.totalLossHa > 0 %}{{ stats.totalLossHa|number_format }}<em>ha</em>{% else %}—{% endif %}</b>
                <span class="sub">{% if stats.yearFrom %}{{ stats.yearFrom }}–{{ stats.yearTo }} · real{% else %}not ingested{% endif %}</span></div>
            <div class="c kpi"><span class="tab"><span class="idx">PL·12</span>Worst year</span>
                <b class="disp">{% if stats.worstYear %}{{ stats.worstYear }}{% else %}—{% endif %}</b>
                <span class="sub">{% if stats.worstYear %}{{ stats.worstHa|number_format }} ha · ex-2001{% else %}awaiting ingestion{% endif %}</span></div>
            <div class="c kpi"><span class="tab"><span class="idx">PL·13</span>Ingestion runs</span>
                <b class="disp">{{ runCount }}</b><span class="sub">dataset_run provenance</span></div>
        </div>

        {# ── Flux: the live map + annual loss (one map controller over both) ─ #}
        <h2 class="zone">Flux — what the ecosystem is doing</h2>
        <div class="grid g32"
             data-controller="map"
             data-map-boundary-value="{{ boundary|json_encode|e('html_attr') }}"
             data-map-forest-loss-url-value="{{ path('forest_loss_geojson', {uuid: area.uuid}) }}">
            <div class="c" id="nca-map" style="padding-top:26px">
                <span class="tab"><span class="idx">PL·14</span>Boundary + tree cover loss<span class="src">· Esri imagery · Hansen/UMD</span></span>
                <span class="lib">leaflet in-app</span>
                {# The whole frame (map + loss-year strip + controls) is what expands, so
                   the dim toggle and forest-loss filter stay usable in full screen. #}
                <div class="map-frame" data-map-target="frame">
                <div class="map-view" style="position:relative;height:380px;border-radius:10px;overflow:hidden">
                    <div id="map" class="absolute inset-0 isolate" data-map-target="canvas" style="position:absolute;inset:0"></div>

                    {# Dim toggle + expand + layer toggle own the top-right; Leaflet's zoom owns the top-left. #}
                    <div style="position:absolute;top:10px;right:10px;z-index:10;display:flex;gap:6px;align-items:flex-start">
                        <button type="button" class="map-pill on" data-map-target="dimBtn" data-action="map#toggleDim" title="Dim outside the boundary">DIM&nbsp;ON</button>
                        <button type="button" class="map-btn" data-action="map#expand" title="Expand map" aria-label="Expand map">{{ ux_icon('lucide:maximize') }}</button>
                        <div class="map-toggle">
                            <button type="button" class="on" data-base="satellite" data-action="map#showBase">Satellite</button>
                            <button type="button" data-base="osm" data-action="map#showBase">Map</button>
                        </div>
                    </div>
                </div>

                {# Loss-year strip — below the map, so the boundary reads unobstructed. #}
                {% if lossByYear is not empty %}
                    <div class="loss-strip" style="display:flex;align-items:center;gap:18px;margin-top:14px;flex-wrap:wrap">
                        <div style="flex:1 1 260px;min-width:220px;max-width:460px">
                            <p class="mono" style="font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--color-fog);margin:0 0 7px">Loss years</p>
                            <div style="position:relative;height:22px">
                                <div style="position:absolute;top:50%;height:6px;width:100%;transform:translateY(-50%);border-radius:99px;background:var(--color-raised)"></div>
                                <div data-map-target="rangeFill" style="position:absolute;top:50%;height:6px;transform:translateY(-50%);border-radius:99px;background:rgb(var(--c-acc));left:0;width:100%"></div>
                                <input type="range" min="2001" max="2023" step="1" value="2001" aria-label="From year"
                                       data-map-target="fromYear" data-action="input->map#filterYears" class="range-thumb absolute inset-0 w-full" style="position:absolute;inset:0;width:100%">
                                <input type="range" min="2001" max="2023" step="1" value="2023" aria-label="To year"
                                       data-map-target="toYear" data-action="input->map#filterYears" class="range-thumb absolute inset-0 w-full" style="position:absolute;inset:0;width:100%">
                            </div>
                        </div>
                        <p class="mono" data-map-target="rangeSummary" style="font-size:12px;color:var(--color-fog);white-space:nowrap;margin:0">
                            {{ stats.yearFrom }}–{{ stats.yearTo }} · {{ stats.totalLossHa|number_format }} ha
                        </p>
                        <div style="min-width:140px">
                            <div class="loss-ramp" style="height:8px;border-radius:4px"></div>
                            <div class="mono" style="display:flex;justify-content:space-between;font-size:8.5px;color:var(--color-dim);margin-top:3px"><span>2001</span><span>2012</span><span>2023</span></div>
                        </div>
                    </div>
                {% else %}
                    <p class="fog" style="font-size:11.5px;margin-top:12px">No forest-loss data yet — run the Hansen ingestion below.</p>
                {% endif %}
                </div>{# /.map-frame #}

                <div class="use"><b>The real thing</b>: satellite mosaic, Hansen loss polygons graduated by year (hover a bar to spotlight), the WDPA boundary from the database.</div>
                <span class="stamp">EPSG:4326 · aoi #{{ area.id }}</span>
            </div>

            <div style="display:flex;flex-direction:column;gap:20px">
                <div class="c" id="annual" style="padding-top:26px">
                    <span class="tab"><span class="idx">PL·15</span>Annual loss<span class="src">· forest_loss_year</span></span>
                    <span class="lib">bar + annotate</span>
                    {% if lossByYear is not empty %}
                        {{ include('forest/_annual_loss_chart.html.twig', {series: lossByYear}) }}
                        <div class="use">Hectares per year; the mean (dashed) excludes 2001, whose bar is clipped — it carries the known Hansen baseline artifact. Hover a bar to spotlight that year on the map, click to filter to it.</div>
                    {% else %}
                        <p class="fog" style="font-size:12px;padding:24px 0;text-align:center">No annual series yet — run the Hansen ingestion.</p>
                    {% endif %}
                </div>

                <div class="c" id="ingest" style="padding-top:26px">
                    <span class="tab"><span class="idx">PL·17</span>Ingestion<span class="src">· Hansen GFC · async</span></span>
                    <form method="post" action="{{ path('dashboard_area_ingest', {uuid: area.uuid}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('ingest' ~ area.uuidString) }}">
                        <button type="submit" class="cta" style="width:100%;border:0;cursor:pointer{{ hasRunningRun ? ';opacity:.5;cursor:not-allowed' : '' }}" {{ hasRunningRun ? 'disabled' : '' }}>
                            {{ hasRunningRun ? 'Ingestion running…' : 'Run Hansen forest-loss ingestion' }}
                        </button>
                    </form>
                    {% if runs is empty %}
                        <p class="fog" style="font-size:12px;margin-top:12px">No runs yet.</p>
                    {% else %}
                        <div style="margin-top:12px">
                            {% for run in runs %}
                                <div class="rln">
                                    <span>#{{ run.id }} · {{ run.dataset }}
                                        {% if run.report %}<span class="d mono" style="font-size:9px">{{ run.report.years ?? '?' }} yr · {{ (run.report.totalHa ?? 0)|number_format }} ha</span>{% endif %}
                                    </span>
                                    <span class="chip {{ run.status == 'succeeded' ? 'ok' : (run.status == 'running' ? 'warn' : 'fail') }}">{{ run.status }}</span>
                                </div>
                                {% if run.error %}<div class="r" style="font-size:10px;padding:0 2px 6px">{{ run.error|slice(0, 160) }}</div>{% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── Module doors (stubs until each context ships) ──────────────── #}
        <h2 class="zone">Flux — what the ecosystem is doing</h2>
        <div class="grid g4">
            <a class="c mod" href="#annual" style="padding:20px 16px 16px"><span class="mt">Forest loss</span><span class="md">The real Hansen series: accounting, decomposition, trend.</span><span class="chip ok">live</span></a>
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Climate</span><span class="md">WorldClim normals, CHIRPS anomalies, CMIP futures.</span><span class="chip warn">template</span></div>
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Drought</span><span class="md">SPEI monitor, drought-class extent, soil-moisture percentiles.</span><span class="chip warn">template</span></div>
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Vegetation</span><span class="md">NDVI envelopes, Hovmöller, phenology shift.</span><span class="chip warn">template</span></div>
        </div>
        <h2 class="zone">Pressure — what people are doing</h2>
        <div class="grid g4">
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Anthropogenic</span><span class="md">Boundary-buffer encroachment: built-up rings, distance decay, edge pressure.</span><span class="chip warn">template</span></div>
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Tourism</span><span class="md">Camps &amp; lodges monitor: expansion, concentration, displacement.</span><span class="chip warn">template</span></div>
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Livestock</span><span class="md">Herd census trends, grazing pressure, stocking vs capacity.</span><span class="chip warn">template</span></div>
            <div class="c mod" style="padding:20px 16px 16px;opacity:.65"><span class="mt">Roads &amp; access</span><span class="md">OSM/GRIP road density, isochrones, fragmentation — planned.</span><span class="chip idle">planned</span></div>
        </div>
        <h2 class="zone">Pulse &amp; synthesis</h2>
        <div class="grid g4">
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Weather stations</span><span class="md">Meteograms, wind roses, soil profiles, warming stripes.</span><span class="chip warn">template</span></div>
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Land cover</span><span class="md">WorldCover composition, sankey transitions, cropland creep.</span><span class="chip warn">template</span></div>
            <div class="c mod" style="padding:20px 16px 16px"><span class="mt">Statistics</span><span class="md">Fits, uncertainty, diagnostics, PCA — the inferential layer.</span><span class="chip warn">template</span></div>
            <div class="c mod" style="padding:20px 16px 16px;opacity:.65"><span class="mt">Water &amp; hydrology</span><span class="md">JRC surface water, lake levels, hydrographs — planned.</span><span class="chip idle">planned</span></div>
        </div>
    </div>
{% endblock %}
