{# Explore tab (map + statistics), fully generic: the module's dissolved layer on the shared Leaflet
   base (coloured by the definition's palette), a data-driven legend, then describe() + a distribution
   over the module's dataframe. Context: table, tableNumeric, describe, distribution, boundary,
   mapLayerUrl, palette, mapDetail, area, module. #}
<div style="display:grid;grid-template-columns:1fr 262px;gap:20px;align-items:start">
    <div class="c" style="padding-top:26px">
        <span class="tab"><span class="idx">MAP</span>{{ module.label }} map<span class="src">· {{ table ? table.source : 'engine' }}{% if mapDetail %} · ~{{ mapDetail.metres }} m{% endif %}</span></span>
        <span class="lib">leaflet in-app</span>
        <div style="margin-top:12px">
            {% if mapLayerUrl or rasterUrl %}
                {{ include('dashboard/_module_map.html.twig', {boundary: boundary, mapId: 'explore-map', height: '360px', classLayerUrl: mapLayerUrl, classPalette: palette, rasterUrl: rasterUrl, rasterBounds: rasterBounds, legend: legend, rasterLegend: rasterLegend}) }}
            {% else %}
                <div style="height:360px;border-radius:10px;display:flex;align-items:center;justify-content:center;text-align:center;background:rgb(var(--c-raised))">
                    <p class="fog" style="font-size:12px;max-width:300px">The module's layer appears here once its map dataset is fetched for this area.</p>
                </div>
            {% endif %}
        </div>
        <div class="use">The module's layer clipped to the AOI.</div>
    </div>
    {% if legend is not empty %}
    <div class="c">
        <span class="tab"><span class="idx">LG</span>Legend<span class="src">· {{ legend|length }} classes</span></span>
        <div style="margin-top:8px;max-height:340px;overflow-y:auto">
            {% for item in legend %}
                <div style="display:flex;align-items:center;gap:9px;padding:5px 0">
                    <span style="width:14px;height:14px;border-radius:3px;flex:none;background:{{ item.color }}"></span>
                    <span style="font-size:12px;flex:1">{{ item.label }}</span>
                    {% if item.value %}<span class="mono d" style="font-size:10px">{{ item.value }}</span>{% endif %}
                </div>
            {% endfor %}
        </div>
        <div class="use">The map layer's classes, coloured by the module's palette.</div>
    </div>
    {% elseif rasterLegend %}
    <div class="c">
        <span class="tab"><span class="idx">LG</span>Legend<span class="src">· surface</span></span>
        <p style="font-size:12px;margin:10px 0 8px">{{ rasterLegend.label }}</p>
        {% set stops = [] %}
        {% for stop in rasterLegend.ramp %}{% set stops = stops|merge(['%s %d%%'|format(stop[1], stop[0] * 100)]) %}{% endfor %}
        <div style="height:12px;border-radius:6px;background:linear-gradient(90deg, {{ stops|join(', ') }})"></div>
        <div style="display:flex;justify-content:space-between;gap:12px;margin-top:5px">
            <span style="font-size:11px;max-width:46%">
                <span class="mono d" style="font-size:10px">{{ rasterLegend.min }}{{ rasterLegend.unit is defined ? ' ' ~ rasterLegend.unit }}</span>
                {% if rasterLegend.low is defined %}<br>{{ rasterLegend.low }}{% endif %}
            </span>
            <span style="font-size:11px;max-width:46%;text-align:right">
                <span class="mono d" style="font-size:10px">{{ rasterLegend.max }}{{ rasterLegend.unit is defined ? ' ' ~ rasterLegend.unit }}</span>
                {% if rasterLegend.high is defined %}<br>{{ rasterLegend.high }}{% endif %}
            </span>
        </div>
        <div class="use">The surface's colour ramp, from the engine run.</div>
    </div>
    {% else %}
    <div class="c">
        <span class="tab"><span class="idx">LG</span>Legend<span class="src">· surface</span></span>
        <p class="fog" style="font-size:12px;margin-top:10px">This module's map is a continuous surface (engine-coloured raster) — no class legend.</p>
    </div>
    {% endif %}
</div>

<div class="grid g2" style="margin-top:22px">
    <div class="c">
        <span class="tab"><span class="idx">DS</span>Summary<span class="src">· describe()</span>{{ include('dashboard/_dataset_chips.html.twig') }}</span>
        <div style="overflow-x:auto;margin-top:2px">
            <table class="dtable">
                <thead>
                    <tr><th>column</th><th class="num">count</th><th class="num">mean</th><th class="num">std</th><th class="num">min</th><th class="num">median</th><th class="num">max</th></tr>
                </thead>
                <tbody>
                    {% for d in describe %}
                        <tr>
                            <td>{{ d.column }}</td>
                            <td class="num">{{ d.count }}</td>
                            <td class="num">{{ d.mean|number_format(2) }}</td>
                            <td class="num">{{ d.std|number_format(2) }}</td>
                            <td class="num">{{ d.min|number_format(2) }}</td>
                            <td class="num">{{ d.median|number_format(2) }}</td>
                            <td class="num">{{ d.max|number_format(2) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="use">Per-column summary statistics for the module's dataframe.</div>
    </div>
    <div class="c">
        <span class="tab"><span class="idx">DT</span>Distribution<span class="src">· {{ tableNumeric|first|default('value') }}</span></span>
        {% if distribution is not empty %}
            {% set maxv = distribution|reduce((m, v) => max(m, v), 0) %}
            <svg viewBox="0 0 300 90" width="100%" height="90" preserveAspectRatio="none" style="display:block;margin-top:12px">
                {% set bw = 300 / distribution|length %}
                {% for v in distribution %}
                    {% set h = maxv > 0 ? (v / maxv) * 84 : 0 %}
                    <rect x="{{ (loop.index0 * bw + 1)|round(2) }}" y="{{ (86 - h)|round(2) }}" width="{{ (bw - 2)|round(2) }}" height="{{ h|round(2) }}" rx="1" fill="rgb(var(--c-acc))"></rect>
                {% endfor %}
            </svg>
        {% endif %}
        <div class="use">The spread of the first numeric column, sorted high → low.</div>
    </div>
</div>
