{# Top-level area tabs — Overview / Modules / Zones / Settings, underlined (.atabs) so they read as
   sections of the area, not module pills. Each is its own route, so each is permission-gated:
   Modules needs module.view, Settings needs area.edit. `active` is the tab slug.

   ZONES carries no gate of its own, exactly like Overview: a zone is a lens, and a lens nobody may
   look through explains nothing — reading the zoning scheme is for anyone who can reach the area,
   while importing, renaming and deleting are Manager-and-up inside the page itself. #}
<div class="atabs">
    <a href="{{ path('dashboard_area_show', {uuid: area.uuid}) }}"{{ active == 'overview' ? ' class="on"' : '' }}>Overview</a>
    {%- if is_granted('module.view') -%}
        <a href="{{ path('dashboard_area_modules_grid', {uuid: area.uuid}) }}"{{ active == 'modules' ? ' class="on"' : '' }}>Modules</a>
    {%- endif -%}
    <a href="{{ path('app_area_zones', {uuid: area.uuid}) }}"{{ active == 'zones' ? ' class="on"' : '' }}>Zones</a>
    {%- if is_granted('area.edit') -%}
        <a href="{{ path('dashboard_area_settings', {uuid: area.uuid}) }}"{{ active == 'settings' ? ' class="on"' : '' }}>Settings</a>
    {%- endif -%}
</div>
