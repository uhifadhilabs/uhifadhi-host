{% extends 'layout.html.twig' %}

{% block title %}Areas — Uhifadhi{% endblock %}

{% block content %}
    <div class="page">
        <div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / areas</div>
        <div class="pghead">
            <div>
                <h1 class="pg">Areas</h1>
                <p class="pgsub">The register: every monitored area, each opening into its own analytical sub-app.</p>
            </div>
            <div class="pgact"><a class="cta" href="{{ path('dashboard_area_new') }}">{{ ux_icon('lucide:plus') }}New area</a></div>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="c" style="padding:12px 16px;margin-bottom:16px"><span class="acc">✓</span> {{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if rows is empty %}
            <div class="c" style="text-align:center;padding:56px 20px">
                <p class="disp" style="font-size:18px;font-weight:700;margin:0 0 8px">No areas yet</p>
                <p class="fog" style="font-size:13px;margin:0 auto 22px;max-width:52ch">
                    Upload a boundary — GeoJSON, zipped Shapefile, GeoPackage, KML/KMZ or a zipped
                    File Geodatabase — and start monitoring it.
                </p>
                <a class="cta" href="{{ path('dashboard_area_new') }}">Upload the first boundary</a>
            </div>
        {% else %}
            <div {{ stimulus_controller('register') }}>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px">
                <input class="fld" placeholder="Search areas… (⌘K)" style="max-width:260px"
                       data-register-target="search" data-action="input->register#search">
                <span class="subnav" style="margin:0">
                    {% for p in [
                        {k: 'all', label: 'All', n: counts.all},
                        {k: 'live', label: 'Live data', n: counts.live},
                        {k: 'fire', label: 'Fire module', n: counts.fire},
                        {k: 'alerts', label: 'With alerts', n: counts.alerts},
                        {k: 'queued', label: 'Queued', n: counts.queued},
                    ] %}
                        <a href="#" data-register-target="pill" data-filter="{{ p.k }}"
                           data-action="register#setFilter"{{ p.k == 'all' ? ' class=on' }}>{{ p.label }} · {{ p.n }}</a>
                    {% endfor %}
                </span>
                <span style="margin-left:auto" class="mono"><span class="chip acc" data-register-target="sortLabel">sort: name ↓</span></span>
            </div>

            <div class="grid">
                <div class="c">
                    <span class="tab"><span class="idx">PL·31</span>All areas<span class="src">· area_of_interest ⋈ area_module</span></span>
                    <span class="lib">register</span>
                    <table class="tbl">
                        <tr>
                            <th data-register-target="header" data-sort="name" data-label="name" data-action="register#sortBy" style="cursor:pointer">Protected area — click to open its sub-app</th>
                            <th data-register-target="header" data-sort="km2" data-label="km²" data-action="register#sortBy" style="text-align:right;cursor:pointer">km²</th>
                            <th>alerts</th>
                            <th>modules</th>
                            <th></th>
                        </tr>
                        {% for row in rows %}
                            <tr data-register-target="row"
                                data-action="click->register#open"
                                data-href="{{ path('dashboard_area_show', {uuid: row.area.uuid}) }}"
                                data-name="{{ row.area.name|lower }}"
                                data-live="{{ row.liveModules > 0 ? 1 : 0 }}" data-fire="0" data-alerts="0"
                                data-km2="{{ row.areaKm2 }}">
                                <td>
                                    <div style="display:flex;gap:12px;align-items:center">
                                        {% if row.thumb %}<img class="thumb" src="{{ row.thumb }}" alt="" loading="lazy" referrerpolicy="no-referrer">{% endif %}
                                        <div>
                                            <div style="font-size:13.5px;font-weight:600">
                                                <a href="{{ path('dashboard_area_show', {uuid: row.area.uuid}) }}">{{ row.area.name }}</a>
                                            </div>
                                            <div class="mono" style="font-size:9px;color:var(--color-dim);margin-top:2px">
                                                {%- if row.area.iucnCategory %}IUCN {{ row.area.iucnCategory }} · {% endif -%}
                                                {%- if row.area.establishedYear %}est. {{ row.area.establishedYear }} · {% endif -%}
                                                {{ row.coords ?? ('source ' ~ row.area.source) }}
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="num">{{ row.areaKm2|number_format }}</td>
                                {# alerts — populated once the Alerts context ships #}
                                <td><span class="d">—</span></td>
                                <td>
                                    {%- if row.liveModules > 0 -%}
                                        <a href="{{ path('dashboard_area_show', {uuid: row.area.uuid}) }}"><span class="chip ok">live · {{ row.liveModules }} module{{ row.liveModules > 1 ? 's' }}</span></a>
                                    {%- else -%}<span class="chip idle">queued</span>{%- endif -%}
                                </td>
                                <td style="text-align:right"><a class="open-btn" href="{{ path('dashboard_area_show', {uuid: row.area.uuid}) }}">Open →</a></td>
                            </tr>
                        {% endfor %}
                    </table>
                    <div class="use"><b>The register as a working list</b> — real satellite thumbnail, identity metadata and module state per row. Geography lives inside each sub-app; here, density wins.</div>
                </div>
            </div>
            </div>{# /register controller #}
        {% endif %}
    </div>
{% endblock %}