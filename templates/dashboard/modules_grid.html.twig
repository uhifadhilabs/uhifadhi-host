{% extends 'layout.html.twig' %}

{% block title %}{{ area.name }} — Modules — Uhifadhi{% endblock %}

{% block content %}
    <div class="page">
        <div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / <a href="{{ path('dashboard_index') }}">areas</a> / <a href="{{ path('dashboard_area_show', {uuid: area.uuid}) }}">{{ area.name|lower }}</a> / modules</div>
        <div class="pghead">
            <div>
                <h1 class="pg">{{ area.name }}</h1>
                <p class="pgsub">Every analytical module on this area — one card, one page. Open a card to view it; edit or run its data from there.</p>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="pgact"><a class="cta" href="{{ path('dashboard_area_modules', {uuid: area.uuid}) }}">{{ ux_icon('lucide:sliders-horizontal') }}Customize</a></div>
            {% endif %}
        </div>

        {{ include('dashboard/_area_tabs.html.twig', {area: area, active: 'modules'}) }}

        {# THE PICTURE IS THE SHELL'S — cards in groups, the status chip, the lens
           marker, the empty state. What is in it is this application's: the
           groups arrive already composed for this viewer on this area, with
           their URLs resolved, because none of that is a layout's to decide. #}
        {{ include('@UhifadhiShell/_module_grid.html.twig', {groups: groups}, with_context: false) }}
    </div>
{% endblock %}
