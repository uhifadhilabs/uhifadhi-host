{# THE APPLICATION'S SHELL: the platform's, plus what only this application knows.

   Everything structural — the document, the sidebar, the location tree, the top
   bar, the page frame, the theme — comes from uhifadhi/shell-module. What is
   left here is exactly the set of things a layout cannot know and an application
   can: who is signed in, whether this response is an impersonation, and this
   deployment's own importmap.

   THE NAV AND THE TAB STRIP ARE NOT HERE ANY MORE, and that is the point. Their
   content is composed in Uhifadhi\Navigation and reaches the shell through its
   two seams, so the sidebar's area branch and the strip above a page read one
   list instead of the two hand-kept copies that used to live in this file and
   in a Twig partial beside it.

   EVERY PAGE THAT EXTENDS THIS still fills `content` exactly as before — that
   socket is the shell's main slot and it kept its name so that this extraction
   changed no page and no module bundle. New pages should extend
   `@UhifadhiShell/page.html.twig` instead and fill `shell_page`: they then get
   the crumb, page head, tab strip and flashes without typing any of them. #}
{% extends '@UhifadhiShell/shell.html.twig' %}

{# One place the whole platform reads its satellite imagery from — the map
   module's seam. Every map controller, this application's own and every
   module's, reads this one attribute, so a layer cannot draw one way on an area
   page and another inside a module. Attributes are not content, so this is the
   shell's one variable rather than one of its blocks; it is set outside every
   block and lands on the document's <body> tag. #}
{% set shell_body_attributes = map_basemap_attributes() %}

{% block stylesheets %}
    {# parent() FIRST: the shell's sheet defines the tokens app.css reads. #}
    {{ parent() }}
    {{ include('_document_head.html.twig') }}
{% endblock %}

{% block importmap %}{{ importmap('app') }}{% endblock %}

{% block shell_banner %}
    {% if is_granted('IS_IMPERSONATOR') %}
        <div class="impersonation-banner">
            {{ ux_icon('lucide:venetian-mask') }}
            <span>Impersonating <b>{{ app.user.fullName }}</b></span>
            <a href="{{ path('dashboard_index', {_switch_user: '_exit'}) }}">Exit</a>
        </div>
    {% endif %}
{% endblock %}

{# The account cluster. It sits in this block rather than in the shell because
   every line of it needs a viewer, and the shell is required to render on an
   installation that has not grown a team yet. #}
{% block shell_topbar_actions %}
    <span class="live"><i></i>worker</span>
    <span class="tb-icon" title="Alerts — coming soon">{{ ux_icon('lucide:bell') }}</span>
    {# The shell's theme toggle, placed rather than appended: parent() is what
       decides where it sits among this application's own chrome. #}
    {{ parent() }}
    {% if app.user %}
        <span class="user" title="{{ app.user.email }}">
            <span class="avatar">{{ (app.user.firstName|first ~ app.user.lastName|first)|upper }}</span>
            <span class="uinfo"><b>{{ app.user.fullName }}</b><em>{{ app.user.teamRole.label }}</em></span>
        </span>
        <a class="tb-icon" href="{{ path('app_logout') }}" title="Sign out" aria-label="Sign out">{{ ux_icon('lucide:log-out') }}</a>
    {% endif %}
{% endblock %}

{% block shell_sidebar_footer %}
    <span class="row" style="cursor:default" title="Settings — coming soon">{{ ux_icon('lucide:settings') }}<span>Settings</span></span>
{% endblock %}

{% block shell_footer %}Uhifadhi — operations platform for protected areas.{% endblock %}
