{% extends 'base.html.twig' %}

{# National shell: collapsible Grafana-style sidebar + a main-area top header.
   Each page fills {% block content %} with its own `.page` (crumb · pghead · body). #}
{# The nav is built server-side, from real data: sections + the location tree under Areas.
   See Uhifadhi\Twig\SidebarExtension — the host never names a module here. #}
{% set _nav = sidebar_nav() %}

{% block body %}
    <div class="shell">
        <aside class="side" id="side" {{ stimulus_controller('sidebar') }}>
            <div class="side-top">
                <a class="brand" href="{{ path('dashboard_index') }}"><img class="brandmark" src="{{ asset('icon.svg') }}" width="30" height="30" alt=""><b>Uhifadhi</b></a>
                <button class="collapse-btn" type="button" data-action="sidebar#toggle"
                        title="Collapse sidebar" aria-label="Collapse sidebar">{{ ux_icon('lucide:chevrons-left') }}</button>
            </div>
            <nav class="nav" {{ stimulus_controller('sidebar-tree') }}>
                <div class="nav-hd">Observatory</div>
                {# Areas + its location TREE: every area is a child row, the area you are in unfolds
                   to its real tabs, and the module you are inside nests under Modules. The caret
                   folds; the label always navigates. #}
                <a class="nav-item{{ _nav.onAreas ? ' on' }}{{ _nav.treeOpen ? '' : ' closed' }}" href="{{ path('dashboard_index') }}">
                    {{ ux_icon('lucide:map') }}<span>Areas</span>
                    <button class="chev" type="button" aria-label="Toggle areas"
                            data-action="sidebar-tree#toggleAreas">{{ ux_icon('lucide:chevron-down') }}</button>
                </a>
                <div class="ntree{{ _nav.treeOpen ? '' : ' treehidden' }}">
                    {% for area in _nav.areas %}
                        <a class="nta{{ area.current ? ' cur' : ' closed' }}" href="{{ area.url }}">
                            <b>{{ area.name }}</b>
                            <button class="chev" type="button" aria-label="Toggle {{ area.name }}"
                                    data-action="sidebar-tree#toggleArea">{{ ux_icon('lucide:chevron-down') }}</button>
                        </a>
                        <div class="nta-group{{ area.current ? '' : ' closed' }}">
                            {% for tab in area.tabs %}
                                <a class="ntt{{ tab.current ? ' on' }}{{ tab.parent ? ' par' }}" href="{{ tab.url }}">{{ tab.label }}
                                    {%- if tab.parent %}<button class="chev" type="button" aria-label="Toggle {{ tab.label }}"
                                            data-action="sidebar-tree#toggleSubtree">{{ ux_icon('lucide:chevron-down') }}</button>{% endif -%}
                                </a>
                                {% if tab.modules is not empty %}
                                    <div class="ntgroup">
                                        {% for module in tab.modules %}
                                            <a class="ntm{{ module.current ? ' on' }}" href="{{ module.url }}"><i class="mdot"></i>{{ module.name }}</a>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
                {# The board is the C-suite surface, so it sits top-level — but it is another slice
                   of this batch, so it degrades to a named-but-unbuilt item until its route lands. #}
                {% if _nav.performanceUrl %}
                    <a class="nav-item{{ _nav.performance ? ' on' }}" href="{{ _nav.performanceUrl }}">{{ ux_icon('lucide:trending-up') }}<span>Performance</span></a>
                {% else %}
                    <span class="nav-item off" title="Performance — coming soon">{{ ux_icon('lucide:trending-up') }}<span>Performance</span></span>
                {% endif %}
                <div class="nav-hd">Organization</div>
                {# Departments are a lens everyone looks through, so the item is not gated the way
                   Team is — only its management chrome is. #}
                <a class="nav-item{{ _nav.departments ? ' on' }}" href="{{ path('app_departments') }}">{{ ux_icon('lucide:building') }}<span>Departments</span></a>
                {% if is_granted('ROLE_MANAGER') %}
                    <a class="nav-item{{ _nav.team ? ' on' }}" href="{{ path('app_team') }}">{{ ux_icon('lucide:users') }}<span>Team</span></a>
                {% endif %}
                <div class="nav-hd">System</div>
                <a class="nav-item{{ app.current_route starts with 'storage_files' ? ' on' }}" href="{{ path('storage_files') }}" title="Files">{{ ux_icon('lucide:images') }}<span>Files</span></a>
                <span class="nav-item off" title="Alerts — planned (workflow + audit roadmap)">{{ ux_icon('lucide:bell') }}<span>Alerts</span></span>
            </nav>
            <div class="side-foot">
                <span class="row" style="cursor:default" title="Settings — coming soon">{{ ux_icon('lucide:settings') }}<span>Settings</span></span>
            </div>
        </aside>

        <main class="main">
            {% if is_granted('IS_IMPERSONATOR') %}
                <div class="impersonation-banner">
                    {{ ux_icon('lucide:venetian-mask') }}
                    <span>Impersonating <b>{{ app.user.fullName }}</b></span>
                    <a href="{{ path('dashboard_index', {_switch_user: '_exit'}) }}">Exit</a>
                </div>
            {% endif %}
            <header class="topbar">
                <span class="tb-right">
                    <span class="live"><i></i>worker</span>
                    <span class="tb-icon" title="Alerts — coming soon">{{ ux_icon('lucide:bell') }}</span>
                    <button class="tb-icon" type="button" {{ stimulus_controller('theme') }} data-action="theme#toggle"
                            title="Toggle theme" aria-label="Toggle theme">{{ ux_icon('lucide:sun') }}</button>
                    {% if app.user %}
                        <span class="user" title="{{ app.user.email }}">
                            <span class="avatar">{{ (app.user.firstName|first ~ app.user.lastName|first)|upper }}</span>
                            <span class="uinfo"><b>{{ app.user.fullName }}</b><em>{{ app.user.teamRole.label }}</em></span>
                        </span>
                        <a class="tb-icon" href="{{ path('app_logout') }}" title="Sign out" aria-label="Sign out">{{ ux_icon('lucide:log-out') }}</a>
                    {% endif %}
                </span>
            </header>

            {% block content %}{% endblock %}

            <div class="page" style="padding-top:0">
                <div class="footer">{% block footer %}Uhifadhi — analytical observatory for protected areas. Sources: Hansen GFC · WDPA. Proof of concept.{% endblock %}</div>
            </div>
        </main>
    </div>
{% endblock %}
