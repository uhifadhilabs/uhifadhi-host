# define your env variables for the test env here
KERNEL_CLASS='Uhifadhi\Kernel'
APP_SECRET='$ecretf0rt3st'

###> symfony/panther ###
# `panther` is not an allowed Kernel env (prod|dev|test) — the E2E server boots `test`.
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0
###< symfony/panther ###

###> symfony/messenger ###
# In tests the async transport is in-memory: dispatches are assertable and
# nothing needs a running worker.
MESSENGER_TRANSPORT_DSN=in-memory://
###< symfony/messenger ###
