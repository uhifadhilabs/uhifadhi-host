#!/bin/sh
# Runs after a successful deploy — applies DB migrations and reconciles the module
# catalogue inside the live container, so `kamal deploy` is one command. Skipped on
# rollback (don't migrate onto old code).
set -e

case "$KAMAL_COMMAND" in
  deploy|redeploy)
    echo "post-deploy » running database migrations"
    # One container only — a bare `app exec` runs on EVERY role, racing
    # concurrent migrations into duplicate-table errors when roles multiply.
    kamal app exec --reuse --primary --roles web "php bin/console doctrine:migrations:migrate --no-interaction"

    # Then reconcile the module catalogue with the module bundles this image actually
    # ships. Without it a deploy that installs a new module bundle leaves the catalogue
    # at the previous release's shape — the module's pages answer, but no area can
    # switch it on because it is in no shop. The command is create-only by design: it
    # refreshes each catalogue row from its provider and backfills only the per-area
    # assignments that are missing, never overruling an admin's on/off or ordering.
    echo "post-deploy » reconciling the module catalogue"
    kamal app exec --reuse --primary --roles web "php bin/console seam:catalogue:seed --no-interaction"

    # And the incident taxonomy, for the same reason and to the same bar. Without it the filing
    # form's "What kind" list is EMPTY and no incident can be reported at all — which is exactly
    # what production shipped with, because the taxonomy is seeded rows and a fresh database has
    # none. It clears the create-only test the catalogue seed set: idempotent (a second run
    # changes nothing), non-destructive (a category dropped from the configuration is left in
    # place, never deleted — incidents are filed against it), and it re-states configuration
    # rather than user work. Nothing in the app edits these rows, so there is no admin decision
    # here for a deploy to overrule.
    echo "post-deploy » reconciling the incident taxonomy"
    kamal app exec --reuse --primary --roles web "php bin/console incidents:taxonomy:sync --no-interaction"

    # Telemetry's SEPARATE database (src/Telemetry) — created if absent, then migrated
    # on its OWN connection, so the API monitor catches /api traffic from the moment the
    # release is up. Both steps are idempotent and touch only the telemetry database (a
    # distinct `uhifadhi_telemetry` in the same accessory), never the app's.
    #
    # DELIBERATELY NON-FATAL, and LAST. The monitor must never break the thing it
    # monitors — that rule extends to the deploy: if TELEMETRY_DATABASE_URL is unset or
    # the telemetry database is unreachable, telemetry stays dark (captures fail-safe and
    # are swallowed) but the app's own deploy still succeeds. Run after every app-critical
    # step above so a telemetry hiccup can never stop them. To activate telemetry, set the
    # TELEMETRY_DATABASE_URL secret (see config/deploy.yml / .kamal/secrets.example) and
    # redeploy — these steps then create and migrate it.
    echo "post-deploy » creating + migrating the telemetry database (non-fatal)"
    if kamal app exec --reuse --primary --roles web "php bin/console doctrine:database:create --connection=telemetry --if-not-exists --no-interaction" \
       && kamal app exec --reuse --primary --roles web "php bin/console telemetry:migrate --no-interaction"; then
      echo "post-deploy » telemetry database ready"
    else
      echo "post-deploy » WARNING: telemetry setup skipped/failed (is TELEMETRY_DATABASE_URL set?) — app deploy unaffected"
    fi
    ;;
  *)
    echo "post-deploy » skipping migrations for '$KAMAL_COMMAND'"
    ;;
esac
