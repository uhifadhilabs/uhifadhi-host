# Copy to .kamal/secrets (gitignored) for LOCAL kamal use, or let the GitHub Actions
# workflow generate it from repo secrets. Kamal expands $VARS from the environment.
# NEVER commit real values.

# GHCR credential — in CI this is the workflow's GITHUB_TOKEN (packages:write).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# PostgreSQL password for the `uhifadhi` DB user (used by the PostGIS `db` accessory).
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Symfony APP_SECRET (any strong random hex).
APP_SECRET=$APP_SECRET

# App DB connection → the `db` accessory (host = <service>-db on the kamal network). PG 17.
DATABASE_URL=postgresql://uhifadhi:$POSTGRES_PASSWORD@uhifadhi-db:5432/uhifadhi?serverVersion=17&charset=utf8
