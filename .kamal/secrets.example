# Copy to .kamal/secrets (gitignored) for LOCAL kamal use, or let the GitHub Actions
# workflow generate it from repo secrets. Kamal expands $VARS from the environment.
# NEVER commit real values.

# GHCR credential — in CI this is the workflow's GITHUB_TOKEN (packages:write).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# PostgreSQL password for the `uhifadhi` DB user (used by the PostGIS `db` accessory).
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Symfony APP_SECRET (any strong random hex).
APP_SECRET=$APP_SECRET

# App DB connection → the `db` accessory (host = <service>-db on the kamal network). PG 17.
DATABASE_URL=postgresql://uhifadhi:$POSTGRES_PASSWORD@uhifadhi-db:5432/uhifadhi?serverVersion=17&charset=utf8

# Telemetry's OWN database (src/Telemetry) — a SEPARATE database in the SAME `db`
# accessory: identical host/user/password, dbname `uhifadhi_telemetry`. In CI this is
# DERIVED from DATABASE_URL automatically (see .github/workflows/deploy.yml), so no repo
# secret is required; the post-deploy hook creates and migrates it. Set this line only for
# LOCAL kamal use, or to override the derivation.
TELEMETRY_DATABASE_URL=postgresql://uhifadhi:$POSTGRES_PASSWORD@uhifadhi-db:5432/uhifadhi_telemetry?serverVersion=17&charset=utf8

# Cloudflare Origin Certificate (PEM) + private key, served by kamal-proxy so the
# Cloudflare → origin hop is HTTPS (Cloudflare SSL/TLS mode = "Full (strict)", proxy ON).
# Generate in Cloudflare → SSL/TLS → Origin Server → Create Certificate (uhifadhi.com, *.uhifadhi.com).
CERTIFICATE_PEM=$CERTIFICATE_PEM
PRIVATE_KEY_PEM=$PRIVATE_KEY_PEM
